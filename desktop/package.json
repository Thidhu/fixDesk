{
  "name": "fixdesk",
  "version": "1.0.0",
  "description": "FixDesk remote support",
  "author": "FixDesk",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --publish never" },
  "dependencies": { "ws": "^8.18.0", "@nut-tree-fork/nut-js": "^4.2.0" },
  "devDependencies": { "electron": "^37.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.fixdesk.app",
    "productName": "FixDesk",
    "files": ["main.js", "preload.js", "agent-core.js", "config.json"],
    "asarUnpack": ["node_modules/@nut-tree-fork/**/*"],
    "npmRebuild": false,
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" }
  }
}
